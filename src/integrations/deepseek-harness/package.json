{
  "name": "corti-memory",
  "version": "0.2.0",
  "description": "Corti persistent cross-session memory for DeepSeek Harness — startup recall injection, per-prompt retrieval, memory tools, turn-end capture, and a Settings/General on/off switch (client half).",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pgmi-builds/corti"
  },
  "keywords": [
    "memory",
    "agent-memory",
    "persistent-context",
    "corti",
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "client.js",
    "corti.yaml.template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
